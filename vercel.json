{
  "buildCommand": "pnpm --filter @workspace/site-sprint-studio run build",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": "vite",
  "outputDirectory": "artifacts/site-sprint-studio/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
